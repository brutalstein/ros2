{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Build",
      "type": "shell",
      "command": "./dev b",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Dev: Run Node",
      "type": "shell",
      "command": "./dev r ${input:node}",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Dev: Check",
      "type": "shell",
      "command": "./dev check",
      "problemMatcher": []
    },
    {
      "label": "Dev: Doctor",
      "type": "shell",
      "command": "./dev doctor",
      "problemMatcher": []
    },
    {
      "label": "Dev: Rebuild",
      "type": "shell",
      "command": "./dev rb",
      "problemMatcher": "$gcc"
    }
  ],
  "inputs": [
    {
      "id": "node",
      "type": "promptString",
      "description": "Node name, e.g. core or imu"
    }
  ]
}
