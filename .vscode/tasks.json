{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workspace: Setup / Repair",
      "type": "shell",
      "command": "./dev setup",
      "problemMatcher": []
    },
    {
      "label": "Dev: Build",
      "type": "shell",
      "command": "./dev b",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Dev: Run Node",
      "type": "shell",
      "command": "./dev r ${input:node}",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Dev: Verify Toolchain",
      "type": "shell",
      "command": "./dev verify",
      "problemMatcher": []
    },
    {
      "label": "Drone: Start Simulation",
      "type": "shell",
      "command": "./drone start",
      "problemMatcher": []
    },
    {
      "label": "Drone: Stop Simulation",
      "type": "shell",
      "command": "./drone stop",
      "problemMatcher": []
    },
    {
      "label": "ROS: Topics",
      "type": "shell",
      "command": "./ros topics",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "node",
      "type": "promptString",
      "description": "Node executable name"
    }
  ]
}
