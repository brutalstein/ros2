{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Init Workspace",
      "type": "shell",
      "command": "./dev init workspace",
      "problemMatcher": []
    },
    {
      "label": "Dev: Build",
      "type": "shell",
      "command": "./dev b",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Dev: Run Node",
      "type": "shell",
      "command": "./dev r ${input:node}",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Dev: Check",
      "type": "shell",
      "command": "./dev check",
      "problemMatcher": []
    },
    {
      "label": "Dev: Doctor",
      "type": "shell",
      "command": "./dev doctor",
      "problemMatcher": []
    },
    {
      "label": "Dev: Rebuild",
      "type": "shell",
      "command": "./dev rb",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Drone: Start Runtime",
      "type": "shell",
      "command": "./drone start",
      "problemMatcher": []
    },
    {
      "label": "Drone: Status",
      "type": "shell",
      "command": "./drone status",
      "problemMatcher": []
    },
    {
      "label": "Drone: Stop Runtime",
      "type": "shell",
      "command": "./drone stop",
      "problemMatcher": []
    },
    {
      "label": "ROS: Topics",
      "type": "shell",
      "command": "./ros topics",
      "problemMatcher": []
    },
    {
      "label": "ROS: Listen Topic",
      "type": "shell",
      "command": "./ros listen ${input:topic}",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ROS: Doctor",
      "type": "shell",
      "command": "./ros doctor",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "node",
      "type": "promptString",
      "description": "Node name, e.g. core or imu"
    },
    {
      "id": "topic",
      "type": "promptString",
      "description": "Topic name, e.g. /drone/status"
    }
  ]
}
