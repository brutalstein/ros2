{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Setup",
      "type": "shell",
      "command": "./dev setup",
      "problemMatcher": []
    },
    {
      "label": "Dev: Build",
      "type": "shell",
      "command": "./dev build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Dev: Test",
      "type": "shell",
      "command": "./dev test",
      "group": "test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Dev: Run Node",
      "type": "shell",
      "command": "./dev run ${input:node}",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Mission: Start",
      "type": "shell",
      "command": "./mission start",
      "problemMatcher": []
    },
    {
      "label": "Mission: Why",
      "type": "shell",
      "command": "./mission why",
      "problemMatcher": []
    },
    {
      "label": "Mission: Stop",
      "type": "shell",
      "command": "./mission stop",
      "problemMatcher": []
    },
    {
      "label": "ROS: Topics",
      "type": "shell",
      "command": "./ros topics",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "node",
      "type": "promptString",
      "description": "Registered node name (see ./dev nodes)"
    }
  ]
}
