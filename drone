#!/usr/bin/env bash
set -eo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCENARIO_TOOL="${ROOT}/tools/scenarios.py"
GAZEBO_TOOL="${ROOT}/tools/gazebo_runtime.py"
QGC_TOOL="${ROOT}/tools/qgroundcontrol.py"
WORLDS_DIR="${ROOT}/simulation/worlds"

case "${1:-}" in
  scenarios)
    exec python3 "${SCENARIO_TOOL}" list
    ;;
  scenario)
    if [[ "${2:-}" == "reset" ]]; then
      exec python3 "${SCENARIO_TOOL}" reset
    fi
    if [[ -z "${2:-}" ]]; then
      exec python3 "${SCENARIO_TOOL}" current
    fi
    exec python3 "${SCENARIO_TOOL}" select "$2"
    ;;
  current-scenario)
    exec python3 "${SCENARIO_TOOL}" current
    ;;
  why)
    exec python3 "${ROOT}/tools/why.py"
    ;;
esac

# Convenience: a scenario name can be passed directly to start.
if [[ "${1:-}" == "start" && -n "${2:-}" ]] && python3 "${SCENARIO_TOOL}" is-known "$2" >/dev/null 2>&1; then
  python3 "${SCENARIO_TOOL}" select "$2" >/dev/null
  set -- start "${@:3}"
fi

SELECTED_SCENARIO="$(python3 "${SCENARIO_TOOL}" current --name-only)"
export PX4_GZ_WORLD="${SELECTED_SCENARIO}"
export PX4_GZ_STANDALONE=1
export GZ_PARTITION="$(python3 "${GAZEBO_TOOL}" partition)"
export DRONE_RUNTIME_OWNER="$(python3 "${GAZEBO_TOOL}" owner)"
export GZ_SIM_RESOURCE_PATH="${WORLDS_DIR}${GZ_SIM_RESOURCE_PATH:+:${GZ_SIM_RESOURCE_PATH}}"

case "${1:-}" in
  start)
    echo "[INFO] scenario: ${PX4_GZ_WORLD}"
    echo "[INFO] Gazebo mode: managed standalone"

    # Start the GCS first so PX4 sees a normal MAVLink ground-station link as
    # soon as SITL comes online. QGroundControl is installed automatically if
    # ./dev setup has not installed it yet.
    python3 "${QGC_TOOL}" start
    python3 "${GAZEBO_TOOL}" start "${SELECTED_SCENARIO}"

    set +e
    python3 "${ROOT}/tools/drone.py" "$@"
    runtime_code=$?
    set -e

    if [[ ${runtime_code} -ne 0 ]]; then
      echo "[WARN] PX4/ROS startup failed; cleaning the partial runtime"
      python3 "${ROOT}/tools/drone.py" stop || true
      python3 "${GAZEBO_TOOL}" stop || true
      python3 "${QGC_TOOL}" stop || true
      exit "${runtime_code}"
    fi

    set +e
    python3 "${QGC_TOOL}" wait-connected
    gcs_code=$?
    set -e

    if [[ ${gcs_code} -ne 0 ]]; then
      echo "[WARN] GCS connection failed; cleaning the partial runtime"
      python3 "${ROOT}/tools/drone.py" stop || true
      python3 "${GAZEBO_TOOL}" stop || true
      python3 "${QGC_TOOL}" stop || true
      exit "${gcs_code}"
    fi

    echo "[OK] runtime ready with QGroundControl"
    exit 0
    ;;

  stop)
    set +e
    python3 "${ROOT}/tools/drone.py" stop
    core_code=$?
    python3 "${GAZEBO_TOOL}" stop
    gazebo_code=$?
    python3 "${QGC_TOOL}" stop
    qgc_code=$?
    set -e
    if [[ ${core_code} -ne 0 ]]; then exit "${core_code}"; fi
    if [[ ${gazebo_code} -ne 0 ]]; then exit "${gazebo_code}"; fi
    exit "${qgc_code}"
    ;;

  cleanup)
    python3 "${ROOT}/tools/drone.py" stop || true
    python3 "${GAZEBO_TOOL}" cleanup || true
    exec python3 "${QGC_TOOL}" stop
    ;;

  status)
    python3 "${ROOT}/tools/drone.py" status
    python3 "${QGC_TOOL}" status
    python3 "${GAZEBO_TOOL}" status
    python3 "${SCENARIO_TOOL}" current
    exit 0
    ;;

  logs)
    if [[ " ${*:2} " != *" -f "* && " ${*:2} " != *" --follow "* ]]; then
      python3 "${ROOT}/tools/drone.py" logs
      echo
      echo "===== QGroundControl ====="
      python3 "${QGC_TOOL}" logs
      python3 "${GAZEBO_TOOL}" logs
      exit 0
    fi
    exec python3 "${ROOT}/tools/drone.py" "$@"
    ;;

  gz-logs)
    exec python3 "${GAZEBO_TOOL}" logs
    ;;

  *)
    exec python3 "${ROOT}/tools/drone.py" "$@"
    ;;
esac
