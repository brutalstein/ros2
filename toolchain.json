{
  "schema_version": 1,
  "profile": "wsl2-ubuntu-24.04-x86_64",
  "support": {
    "os_id": "ubuntu",
    "os_versions": ["24.04"],
    "architectures": ["x86_64", "amd64"],
    "wsl2": "preferred",
    "native_ubuntu": true
  },
  "stack": {
    "ros": {
      "distro": "jazzy",
      "apt_source_version": "1.2.0",
      "apt_packages": [
        "ros-jazzy-ros-base",
        "ros-dev-tools",
        "ros-jazzy-ros-gz",
        "ros-jazzy-sensor-msgs",
        "ros-jazzy-cv-bridge",
        "libopencv-dev"
      ]
    },
    "px4": {
      "repo": "https://github.com/PX4/PX4-Autopilot.git",
      "ref": "v1.17.0",
      "messages_ref": "release/1.17",
      "sim_target": "gz_x500_mono_cam"
    },
    "px4_msgs": {
      "repo": "https://github.com/PX4/px4_msgs.git",
      "ref": "release/1.17"
    },
    "micro_xrce_dds_agent": {
      "repo": "https://github.com/eProsima/Micro-XRCE-DDS-Agent.git",
      "ref": "v2.4.3",
      "port": 8888
    },
    "gazebo": {
      "family": "Harmonic",
      "expected_major": 8
    },
    "qgroundcontrol": {
      "enabled": true,
      "version": "v5.0.8",
      "download_url": "https://github.com/mavlink/QGroundControl/releases/download/v5.0.8/QGroundControl-x86_64.AppImage",
      "filename": "QGroundControl-x86_64.AppImage",
      "sha256": "06969c67ef58ea063def0a8271447a1cc385438c4a7df36813315b4475146737",
      "size_bytes": 180816376,
      "udp_port": 14550,
      "launch_timeout_seconds": 20,
      "connection_timeout_seconds": 30,
      "apt_packages": [
        "libfuse2",
        "libxcb-xinerama0",
        "libxkbcommon-x11-0",
        "libxcb-cursor0",
        "gstreamer1.0-plugins-bad",
        "gstreamer1.0-libav",
        "gstreamer1.0-gl"
      ]
    },
    "camera_bridge": {
      "enabled": true,
      "ros_package": "ros_gz_bridge",
      "targets": [
        "gz_x500_mono_cam",
        "gz_x500_mono_cam_down"
      ],
      "gazebo_image_suffix": "/link/camera_link/sensor/imager/image",
      "gazebo_info_suffix": "/link/camera_link/sensor/imager/camera_info",
      "ros_image_topic": "/camera/image_raw",
      "ros_info_topic": "/camera/camera_info",
      "bridge_camera_info": false,
      "startup_timeout_seconds": 30,
      "bridge_timeout_seconds": 12
    }
  },
  "vscode": {
    "extensions": [
      "ms-vscode.cpptools",
      "ms-vscode.cmake-tools",
      "ms-iot.vscode-ros",
      "ms-vscode-remote.remote-wsl"
    ]
  }
}
